{
  "expo": {
    "name": "Journal IQ",
    "slug": "journal-iq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "journaliq",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.journaliq.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Journal IQ needs photo access so you can set a profile picture.",
        "NSCameraUsageDescription": "Journal IQ needs camera access so you can take a profile picture."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#01122F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.journaliq.app",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "journaliq",
              "host": "reset-password"
            },
            {
              "scheme": "journaliq",
              "pathPrefix": "/reset-password"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#01122F"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Journal IQ to use Face ID for app lock."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Journal IQ to access your photos for a profile picture.",
          "cameraPermission": "Allow Journal IQ to use the camera for a profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#C4E562"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "journal-iq-local"
      }
    }
  }
}
