{
  "expo": {
    "name": "Journal IQ",
    "slug": "journal-iq",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "journaliq",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.journaliq.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Journal IQ needs photo access so you can set a profile picture.",
        "NSCameraUsageDescription": "Journal IQ needs camera access so you can take a profile picture.",
        "NSFaceIDUsageDescription": "Journal IQ uses biometrics to unlock the app when app lock is enabled."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#01122F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.journaliq.app",
      "versionCode": 1,
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "journaliq",
              "host": "reset-password"
            },
            {
              "scheme": "journaliq",
              "pathPrefix": "/reset-password"
            }
          ]
        }
      ],
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.READ_CONTACTS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.QUERY_ALL_PACKAGES",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#01122F"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Journal IQ to use biometrics for app lock."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Journal IQ to access your photos for a profile picture.",
          "cameraPermission": "Allow Journal IQ to use the camera for a profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#C4E562"
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5bb16ab8-f71e-4009-8f3f-4ff2a7ac3ff5"
      }
    },
    "owner": "technology726"
  }
}
