# Server
NODE_ENV=development
PORT=4000

# Neon Postgres — use the pooled connection string from Neon console
# IMPORTANT: rotate password if this URL was ever shared in chat
DATABASE_URL=

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30

# OpenAI (optional in dev — fallback reflections used when empty)
OPENAI_API_KEY=

# Gmail SMTP for password-reset emails (use a Google App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Journal IQ <you@gmail.com>
MOBILE_RESET_URL=journaliq://reset-password
CLIENT_ORIGIN=*

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:4000

# Optional: public HTTPS URLs for Google Play Console (host docs/legal/*.html)
# EXPO_PUBLIC_PRIVACY_URL=https://your-domain.com/privacy
# EXPO_PUBLIC_TERMS_URL=https://your-domain.com/terms

# Optional: Sentry crash reporting (leave empty to disable)
# EXPO_PUBLIC_SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0
# EXPO_PUBLIC_SENTRY_DEV=1
# SENTRY_AUTH_TOKEN=  # EAS secret for source maps — never commit
