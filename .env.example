# Server
NODE_ENV=development
PORT=5000

# Neon Postgres — use the pooled connection string from Neon console
# Prefer sslmode=require (or verify-full). Rotate password if ever shared.
DATABASE_URL=

# Min 32 chars each. Never use change-me values in production.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30
JWT_ISSUER=journal-iq-api
JWT_AUDIENCE=journal-iq-mobile

# OpenAI (optional in dev — fallback reflections used when empty)
OPENAI_API_KEY=

# Gmail SMTP for password-reset emails (use a Google App Password, not your normal password)
# REQUIRED when NODE_ENV=production — reset URLs are never logged in production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Journal IQ <you@gmail.com>
MOBILE_RESET_URL=journaliq://reset-password

# Comma-separated web origins only. Leave empty for mobile-only API (recommended).
# Do not use * in production.
CLIENT_ORIGIN=

# Mobile
# Dev: http://localhost:4000 (or LAN IP / 10.0.2.2). Production builds REQUIRE https://
EXPO_PUBLIC_API_URL=http://localhost:4000

# Optional: public HTTPS URLs for Google Play Console (host docs/legal/*.html)
# EXPO_PUBLIC_PRIVACY_URL=https://your-domain.com/privacy
# EXPO_PUBLIC_TERMS_URL=https://your-domain.com/terms

# Optional: Sentry crash reporting (leave empty to disable)
# EXPO_PUBLIC_SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0
# EXPO_PUBLIC_SENTRY_DEV=1
# SENTRY_AUTH_TOKEN=  # EAS secret for source maps — never commit
