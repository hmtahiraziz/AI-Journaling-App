{
  "name": "journal-iq",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@journal-iq/backend",
    "dev:backend": "npm run dev --workspace=@journal-iq/backend",
    "dev:api": "npm run dev --workspace=@journal-iq/backend",
    "dev:mobile": "npm run start --workspace=@journal-iq/mobile",
    "db:generate": "npm run db:generate --workspace=@journal-iq/backend",
    "db:migrate": "npm run db:migrate --workspace=@journal-iq/backend",
    "db:seed": "npm run db:seed --workspace=@journal-iq/backend",
    "build:shared": "npm run build --workspace=@journal-iq/shared",
    "build": "npm run build:backend",
    "build:backend": "npm run build:shared && npm run db:generate && npm run build --workspace=@journal-iq/backend",
    "start": "npm run start:backend",
    "start:backend": "npm run start --workspace=@journal-iq/backend",
    "deploy:backend:build": "npm run build:backend",
    "deploy:backend:start": "npm run start:backend",
    "deploy:backend:migrate": "npm run db:migrate"
  },
  "engines": {
    "node": ">=22.13"
  }
}
